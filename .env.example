# URL pública da aplicação (sem barra final)
NEXT_PUBLIC_APP_URL=https://fabiocalixto.com

# Better Auth
BETTER_AUTH_SECRET=gera-com-openssl-rand-base64-32
BETTER_AUTH_URL=https://fabiocalixto.com

# Base de dados (MySQL / MariaDB)
DATABASE_URL=mysql://user:password@localhost:3306/fabiocalixto
DATABASE_HOST=localhost
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=fabiocalixto

# UploadThing
UPLOADTHING_TOKEN=

# Seed do administrador (obrigatório em produção)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=
